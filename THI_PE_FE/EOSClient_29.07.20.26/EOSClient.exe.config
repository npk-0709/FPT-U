<?xml version="1.0"?>
<configuration>
	<appSettings>
		<!--   User application and configured property settings go here.-->
		<!--   Example: <add key="settingName" value="settingValue"/> -->
		<add key="domain" value="FU.EDU.VN"/>
		<!-- Local testing only: true lets Alt+Tab work while the exam screen is open. Must be false for real exams. -->
	</appSettings>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
		<supportedRuntime version="v2.0.50727"/>
	</startup>
</configuration>
