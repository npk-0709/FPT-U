<mxfile host="app.diagrams.net" type="device">
  <diagram name="Class Diagram" id="mhc-class-diagram">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1600" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Mountain Hiking Challenge Registration &#8211; Class Diagram" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="500" y="10" width="900" height="40" as="geometry" />
        </mxCell>

        <!-- Main -->
        <mxCell id="main" value="&lt;b&gt;Main&lt;/b&gt;&lt;br&gt;&lt;i&gt;&#171;entry point&#187;&lt;/i&gt;&lt;hr&gt;- inp : Inputter {static}&lt;br&gt;- mountains : Mountains {static}&lt;br&gt;- students : Students {static}&lt;br&gt;- volunteers : Volunteers {static}&lt;br&gt;- accounts : Accounts {static}&lt;br&gt;- currentUser : Account {static}&lt;hr&gt;+ main(args) : void {static}&lt;br&gt;- login() : boolean&lt;br&gt;- runMenu(...) : void&lt;br&gt;- buildMainMenu() : List&amp;lt;MenuItem&amp;gt;&lt;br&gt;- addNewRegistration() : void&lt;br&gt;- updateRegistration() : void&lt;br&gt;- displayRegisteredList() : void&lt;br&gt;- deleteRegistration() : void&lt;br&gt;- searchByName() : void&lt;br&gt;- filterByCampus() : void&lt;br&gt;- showStatistics() : void&lt;br&gt;- saveDataToFile() : void&lt;br&gt;- volunteerManagement() : void&lt;br&gt;- accountManagement() : void&lt;br&gt;- confirmExit() : boolean" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="300" height="340" as="geometry" />
        </mxCell>

        <!-- MenuItem -->
        <mxCell id="menuitem" value="&lt;b&gt;MenuItem&lt;/b&gt;&lt;hr&gt;- label : String&lt;br&gt;- permission : Permission&lt;br&gt;- action : Runnable&lt;hr&gt;+ MenuItem(label, permission, action)&lt;br&gt;+ getLabel() : String&lt;br&gt;+ isAllowedFor(account) : boolean&lt;br&gt;+ execute() : void" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="70" width="260" height="150" as="geometry" />
        </mxCell>

        <!-- Inputter -->
        <mxCell id="inputter" value="&lt;b&gt;Inputter&lt;/b&gt;&lt;br&gt;&lt;i&gt;&#171;utility&#187;&lt;/i&gt;&lt;hr&gt;- ndl : Scanner&lt;hr&gt;+ getString(mess) : String&lt;br&gt;+ getInt(mess) : int&lt;br&gt;+ getDouble(mess) : double&lt;br&gt;+ inputAndLoop(mess, pattern) : String&lt;br&gt;+ inputAndLoopAllowEmpty(...) : String&lt;br&gt;+ confirmYesNo(mess) : boolean&lt;br&gt;+ getMenuChoice(mess, min, max) : int" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="70" width="280" height="180" as="geometry" />
        </mxCell>

        <!-- Acceptable -->
        <mxCell id="acceptable" value="&lt;b&gt;Acceptable&lt;/b&gt;&lt;br&gt;&lt;i&gt;&#171;interface&#187;&lt;/i&gt;&lt;hr&gt;+ STUDENT_ID, CAMPUS_CODE, NAME_VALID ... {static}&lt;br&gt;+ USERNAME_VALID, PASSWORD_VALID {static}&lt;br&gt;+ VOLUNTEER_ID, SHIFT_VALID {static}&lt;hr&gt;+ isValid(data, pattern) : boolean {static}" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1000" y="70" width="300" height="130" as="geometry" />
        </mxCell>

        <!-- Permission -->
        <mxCell id="permission" value="&lt;b&gt;Permission&lt;/b&gt;&lt;br&gt;&lt;i&gt;&#171;enum&#187;&lt;/i&gt;&lt;hr&gt;CREATE_REGISTRATION&lt;br&gt;UPDATE_REGISTRATION&lt;br&gt;VIEW_REGISTRATION&lt;br&gt;DELETE_REGISTRATION&lt;br&gt;VIEW_STATISTICS&lt;br&gt;SAVE_DATA&lt;br&gt;MANAGE_VOLUNTEER&lt;br&gt;MANAGE_ACCOUNT" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
