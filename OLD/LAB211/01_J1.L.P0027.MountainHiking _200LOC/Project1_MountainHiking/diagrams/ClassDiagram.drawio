        <!-- Mountain -->
        <mxCell id="mountain" value="&lt;b&gt;Mountain&lt;/b&gt;&lt;hr&gt;- mountainCode : String&lt;br&gt;- mountain : String&lt;br&gt;- province : String&lt;br&gt;- description : String&lt;hr&gt;+ getters&lt;br&gt;+ toString()&lt;br&gt;+ equals() / hashCode()" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
