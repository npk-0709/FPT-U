        </mxCell>
        <mxCell id="m9" value="9: account" style="endArrow=open;dashed=1;html=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="575" y="350" as="sourcePoint" />
            <mxPoint x="575" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="10: authenticate(password)" style="endArrow=block;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="575" y="450" as="sourcePoint" />
            <mxPoint x="725" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m11" value="11: true/false" style="endArrow=open;dashed=1;html=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="725" y="480" as="sourcePoint" />
            <mxPoint x="575" y="480" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m12" value="12: Account / null" style="endArrow=open;dashed=1;html=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="565" y="510" as="sourcePoint" />
            <mxPoint x="255" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Alt frame -->
        <mxCell id="alt_frame" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=60;height=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;align=left;verticalAlign=top;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="140" y="530" width="680" height="200" as="geometry" />
