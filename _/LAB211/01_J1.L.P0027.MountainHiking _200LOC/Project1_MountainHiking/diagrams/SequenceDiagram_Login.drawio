<mxfile host="app.diagrams.net" type="device">
  <diagram name="Sequence - Login" id="mhc-seq-login">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Sequence Diagram &#8211; Đăng nhập hệ thống (Login)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="700" height="36" as="geometry" />
        </mxCell>

        <!-- Actors & Lifelines -->
        <mxCell id="actor" value="User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="40" height="80" as="geometry" />
        </mxCell>
        <mxCell id="main" value=":Main" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontStyle=1;" vertex="1" parent="1">
