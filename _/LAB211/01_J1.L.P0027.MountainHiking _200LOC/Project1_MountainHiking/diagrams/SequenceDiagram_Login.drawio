        <mxCell id="ll_acc" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="570" y="120" as="sourcePoint" />
            <mxPoint x="570" y="780" as="targetPoint" />
          </mxGeometry>
