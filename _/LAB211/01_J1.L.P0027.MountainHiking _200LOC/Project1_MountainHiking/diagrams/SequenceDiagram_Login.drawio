        <mxCell id="account" value=":Account" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="80" width="100" height="40" as="geometry" />
        </mxCell>

        <!-- Lifeline dashed lines -->
        <mxCell id="ll_user" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="160" as="sourcePoint" />
            <mxPoint x="80" y="780" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll_main" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
