        <mxCell id="alt_fail" value="[else - sai mật khẩu, attempt &amp;lt; 3]" style="text;html=1;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="150" y="670" width="280" height="20" as="geometry" />
        </mxCell>
        <mxCell id="m16" value="16: &quot;Invalid username or password&quot;" style="endArrow=open;dashed=1;html=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1">
