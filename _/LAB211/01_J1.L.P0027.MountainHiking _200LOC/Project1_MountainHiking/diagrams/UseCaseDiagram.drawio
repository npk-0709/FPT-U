<mxfile host="app.diagrams.net" type="device">
  <diagram name="Use Case Diagram" id="mhc-usecase">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Use Case Diagram &#8211; Mountain Hiking Challenge Registration" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="700" height="36" as="geometry" />
        </mxCell>

        <!-- System boundary -->
        <mxCell id="boundary" value="Mountain Hiking Registration System" style="shape=umlFrame;whiteSpace=wrap;html=1;width=320;height=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="200" y="80" width="700" height="680" as="geometry" />
        </mxCell>

        <!-- Actors -->
        <mxCell id="admin" value="Admin" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="40" height="80" as="geometry" />
        </mxCell>
        <mxCell id="staff" value="Staff" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="40" height="80" as="geometry" />
        </mxCell>
        <mxCell id="viewer" value="Viewer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- Use Cases -->
        <mxCell id="uc_login" value="Login" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="120" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_add" value="New Registration" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="200" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_update" value="Update Registration" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="270" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_display" value="Display List" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="340" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_delete" value="Delete Registration" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="410" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_search" value="Search / Filter" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="480" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_stats" value="Statistics" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="550" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_save" value="Save Data" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="200" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_volunteer" value="Volunteer Management" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="290" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_account" value="Account Management" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="380" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_exit" value="Exit" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="470" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_validate" value="&lt;&lt;include&gt;&gt;&#xa;Validate Input" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="720" y="300" width="130" height="55" as="geometry" />
        </mxCell>

        <!-- Associations Admin -->
        <mxCell id="e_admin_login" style="endArrow=none;html=1;strokeColor=#333;" edge="1" parent="1" source="admin" target="uc_login"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_admin_add" style="endArrow=none;html=1;strokeColor=#333;" edge="1" parent="1" source="admin" target="uc_add"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_admin_del" style="endArrow=none;html=1;strokeColor=#333;" edge="1" parent="1" source="admin" target="uc_delete"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_admin_acc" style="endArrow=none;html=1;strokeColor=#333;" edge="1" parent="1" source="admin" target="uc_account"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Associations Staff -->
        <mxCell id="e_staff_add" style="endArrow=none;html=1;strokeColor=#333;" edge="1" parent="1" source="staff" target="uc_add"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_staff_vol" style="endArrow=none;html=1;strokeColor=#333;" edge="1" parent="1" source="staff" target="uc_volunteer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_staff_save" style="endArrow=none;html=1;strokeColor=#333;" edge="1" parent="1" source="staff" target="uc_save"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Associations Viewer -->
        <mxCell id="e_viewer_display" style="endArrow=none;html=1;strokeColor=#333;" edge="1" parent="1" source="viewer" target="uc_display"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_viewer_stats" style="endArrow=none;html=1;strokeColor=#333;" edge="1" parent="1" source="viewer" target="uc_stats"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Include relationships -->
        <mxCell id="inc1" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="endArrow=open;dashed=1;html=1;strokeColor=#9673a6;fontSize=10;" edge="1" parent="1" source="uc_add" target="uc_validate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="inc2" style="endArrow=open;dashed=1;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="uc_update" target="uc_validate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="inc3" style="endArrow=open;dashed=1;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="uc_delete" target="uc_validate"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Chú thích màu&lt;/b&gt;&lt;hr&gt;&#9632; Xanh lá: Tất cả role&#160;&#160;&#9632; Vàng: Admin + Staff&#160;&#160;&#9632; Đỏ: Chỉ Admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="200" y="780" width="500" height="50" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
